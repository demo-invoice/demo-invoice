# Required environment variables for the Send Invoice feature (T24)
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# SendGrid API key — must have "Mail Send" permission
# https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address registered in your SendGrid account
# https://app.sendgrid.com/settings/sender_auth
SENDGRID_FROM_EMAIL=invoices@yourdomain.com

# NOTE: PDF attachment support is deferred to a follow-up ticket.
# (PO working assumption — Sara, confidence 0.35; flagged for PR review)
