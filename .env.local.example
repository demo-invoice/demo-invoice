# Copy this file to .env.local and populate the values.
# .env.local is gitignored and must NEVER be committed.

# Resend API key — obtain from https://resend.com/api-keys
# NOTE (T24): Resend was chosen as the email service provider based on Sara's
# recommendation (confidence 0.4). This is a working assumption pending final
# PO confirmation. If the provider changes, only this env var and
# src/pages/api/send-invoice.ts need updating.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The verified sender address configured in your Resend account.
# Must match a domain you have verified at resend.com/domains.
RESEND_FROM_EMAIL=invoices@yourdomain.com
